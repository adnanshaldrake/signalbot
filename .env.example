# =============================================================================
# signalbot — Environment Variable Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and should NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   source .env && ./signalbot
#   # OR use docker-compose which reads .env automatically
# =============================================================================

# -----------------------------------------------------------------------------
# Binance API Credentials
# Required only when PAPER_TRADING=false
# Get these from: https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binance.vision/
# -----------------------------------------------------------------------------
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE

# -----------------------------------------------------------------------------
# Trading Mode
# PAPER_TRADING=true  → simulate trades, no real orders placed (safe default)
# PAPER_TRADING=false → live trading with real money (be careful!)
# USE_TESTNET=true    → use testnet.binance.vision instead of api.binance.com
# -----------------------------------------------------------------------------
PAPER_TRADING=true
USE_TESTNET=true

# -----------------------------------------------------------------------------
# Strategy Parameters
# CANDLE_INTERVAL: one of 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d
# CANDLE_LIMIT:    number of historical candles to load (max 1000 per Binance API)
# -----------------------------------------------------------------------------
CANDLE_INTERVAL=15m
CANDLE_LIMIT=100

# -----------------------------------------------------------------------------
# Watchlist (Fallback)
# Comma-separated list of USDT trading pairs to use as a fallback if the
# screener yields no profitable symbols, or if SCREEN_ON_STARTUP=false.
# Example: BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
# -----------------------------------------------------------------------------
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT

# -----------------------------------------------------------------------------
# Risk Management
# MAX_POSITIONS:      maximum number of simultaneous open trades
# MAX_POSITION_USDT:  maximum USDT value per single trade
# STOP_LOSS_PCT:      stop-loss % below entry price (e.g. 2.0 = -2%)
# TAKE_PROFIT_PCT:    take-profit % above entry price (e.g. 4.0 = +4%)
# MAX_DAILY_LOSS_PCT: kill-switch — halt all trading if daily loss exceeds this %
# TAKER_FEE_PCT:      per-side fee percentage used for net PnL (default 0.1 = 0.1%)
# -----------------------------------------------------------------------------
MAX_POSITIONS=3
MAX_POSITION_USDT=50.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_DAILY_LOSS_PCT=5.0
TAKER_FEE_PCT=0.1

# -----------------------------------------------------------------------------
# Redis (optional)
# Leave REDIS_URL empty to run fully in-memory (no Redis needed — great for
# local development). Positions will be lost on restart in this mode.
# Set REDIS_URL to use Redis for persistent position tracking across restarts.
# -----------------------------------------------------------------------------
REDIS_URL=
REDIS_USERNAME=
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# SQLite — Historical Data & Backtesting
# Path to the SQLite database file (relative to project root)
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=data/signalbot.db

# -----------------------------------------------------------------------------
# Telegram Notifications (optional)
# If TELEGRAM_BOT_TOKEN is empty, notifications are silently disabled.
# 1. Create a bot via @BotFather on Telegram → get the token
# 2. Send a message to your bot, then get your chat ID:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# -----------------------------------------------------------------------------
# Startup Symbol Screener (Primary)
# When SCREEN_ON_STARTUP=true (default), the bot:
#   1. Fetches the top SCREEN_TOP_N USDT pairs by 24h volume from Binance
#   2. Backfills their candles into SQLite (~20-40s, fast on repeat runs)
#   3. Runs a backtest on each and filters by win rate + PnL thresholds
#   4. Uses the profitable screened symbols for live trading (best PnL first)
#   5. Falls back to WATCHLIST only if 0 symbols pass the screen
# Set SCREEN_ON_STARTUP=false to disable screening and directly use WATCHLIST.
# -----------------------------------------------------------------------------
SCREEN_ON_STARTUP=true
SCREEN_TOP_N=40
SCREEN_MIN_WIN_RATE=35.0
SCREEN_MIN_PNL=0.0
SCREEN_MIN_TRADES=3
