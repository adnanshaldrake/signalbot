# =============================================================================
# signalbot — Environment Variable Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and should NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   source .env && ./signalbot
#   # OR use docker-compose which reads .env automatically
# =============================================================================

# -----------------------------------------------------------------------------
# Binance API Credentials
# Required only when PAPER_TRADING=false
# Get these from: https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binance.vision/
# -----------------------------------------------------------------------------
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE

# -----------------------------------------------------------------------------
# Trading Mode
# PAPER_TRADING=true  → simulate trades, no real orders placed (safe default)
# PAPER_TRADING=false → live trading with real money (be careful!)
# USE_TESTNET=true    → use testnet.binance.vision instead of api.binance.com
# -----------------------------------------------------------------------------
PAPER_TRADING=true
USE_TESTNET=true

# -----------------------------------------------------------------------------
# Strategy Parameters
# CANDLE_INTERVAL: one of 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d
# CANDLE_LIMIT:    number of historical candles to load (max 1000 per Binance API)
# -----------------------------------------------------------------------------
CANDLE_INTERVAL=15m
CANDLE_LIMIT=100

# -----------------------------------------------------------------------------
# Watchlist
# Comma-separated list of USDT trading pairs to monitor.
# Leave empty to scan ALL USDT spot pairs (300+ symbols — slower).
# Example: BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
# -----------------------------------------------------------------------------
WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,DOTUSDT,LINKUSDT

# -----------------------------------------------------------------------------
# Risk Management
# MAX_POSITIONS:      maximum number of simultaneous open trades
# MAX_POSITION_USDT:  maximum USDT value per single trade
# STOP_LOSS_PCT:      stop-loss % below entry price (e.g. 2.0 = -2%)
# TAKE_PROFIT_PCT:    take-profit % above entry price (e.g. 4.0 = +4%)
# MAX_DAILY_LOSS_PCT: kill-switch — halt all trading if daily loss exceeds this %
# -----------------------------------------------------------------------------
MAX_POSITIONS=3
MAX_POSITION_USDT=50.0
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
MAX_DAILY_LOSS_PCT=5.0

# -----------------------------------------------------------------------------
# Redis
# Used for caching live ticker data and storing position state
# Default points to a local Redis instance; update for remote/Docker Redis
# REDIS_CREDS format: username:password (leave as ":" for no auth)
# -----------------------------------------------------------------------------
REDIS_URL=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# SQLite — Historical Data & Backtesting
# Path to the SQLite database file (relative to project root)
# -----------------------------------------------------------------------------
SQLITE_DB_PATH=data/signalbot.db

# -----------------------------------------------------------------------------
# Telegram Notifications (optional)
# If TELEGRAM_BOT_TOKEN is empty, notifications are silently disabled.
# 1. Create a bot via @BotFather on Telegram → get the token
# 2. Send a message to your bot, then get your chat ID:
#    curl https://api.telegram.org/bot<TOKEN>/getUpdates
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
